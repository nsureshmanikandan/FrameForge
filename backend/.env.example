# ══════════════════════════════════════════
# FrameForge Enterprise Configuration
# ══════════════════════════════════════════

# ─── Azure OpenAI ────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MAX_TOKENS=16000

# ─── Figma ───────────────────────────────
FIGMA_ACCESS_TOKEN=your-figma-token-here
FIGMA_API_BASE=https://api.figma.com/v1

# ─── Storage ─────────────────────────────
STORAGE_BACKEND=local
LOCAL_HISTORY_DIR=./data/history
MAX_HISTORY_ITEMS=200

# ─── Security ────────────────────────────
# API_KEY=  # Optional: Set to require API key for all requests
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://localhost:8002"]

# ─── Rate Limiting ───────────────────────
RATE_LIMIT_PER_MINUTE=30
GENERATION_RATE_LIMIT_PER_MINUTE=10

# ─── Application ─────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
